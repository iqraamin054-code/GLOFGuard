# Web app / Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Runtime mode is REAL by default. Mock mode must be explicitly enabled and is
# always written to data/mock by the CLI.
GLOF_DATA_MODE=real
GLOF_ALLOW_MOCK_DATA=false

# Storage and versioning
GLOF_DATABASE_PATH=data/glofguard.sqlite3
GLOF_TIMESERIES_CSV_PATH=data/lake_observations.csv
GLOF_MODEL_VERSION=transparent-conditions-index-v0.1.0

# A saved model is used only when this explicit provenance gate is true and a
# matching preprocessor/model pair is provided. Do not point this at the
# existing preprocessor alone; this repository has no validated classifier.
GLOF_MODEL_VALIDATED=false
GLOF_BASELINE_PREPROCESSING_PATH=
GLOF_BASELINE_MODEL_PATH=
GLOF_DYNAMIC_PREPROCESSING_PATH=
GLOF_DYNAMIC_MODEL_PATH=

# Google Earth Engine / Sentinel-2, JAXA GSMaP, and NOAA GFS. Credentials are
# created by the official Earth Engine authentication command and are never
# stored in this repository.
GLOF_GEE_PROJECT=
GLOF_SENTINEL_LOOKBACK_DAYS=30
# Search farther back for the latest reliable lake area without changing the
# freshness threshold. The actual observation age is always reported.
GLOF_SENTINEL_AREA_LOOKBACK_DAYS=180
GLOF_SENTINEL_SEARCH_RADIUS_M=1000
GLOF_SENTINEL_CLOUD_SCORE_THRESHOLD=0.60
GLOF_SENTINEL_MAX_CLOUD_PERCENT=35
GLOF_SENTINEL_MIN_CLEAR_FRACTION=0.65
GLOF_SENTINEL_WATER_INDEX=MNDWI
GLOF_SENTINEL_WATER_THRESHOLD=0.10
GLOF_SENTINEL_MAX_CANDIDATE_SCENES=12
GLOF_SENTINEL_AREA_MAX_CANDIDATE_SCENES=60

# NASA POWER is the historical climate baseline. This public endpoint does not
# require an API key; its publication delay is not a live freshness condition.
GLOF_NASA_POWER_DAILY_URL=https://power.larc.nasa.gov/api/temporal/daily/point
GLOF_NASA_TIMEOUT_SECONDS=60
GLOF_NASA_POWER_BASELINE_YEARS=10
GLOF_OBSERVED_WEATHER_MIN_COVERAGE=0.80

# Staleness thresholds used to lower confidence and show warnings.
GLOF_SATELLITE_STALE_DAYS=20
GLOF_WEATHER_STALE_HOURS=36
GLOF_FORECAST_STALE_HOURS=12
